{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PHP PatchGuide advisory",
  "type": "object",
  "required": [
    "id",
    "title",
    "severity",
    "fixed_by",
    "url"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "version",
        "mitigation"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "published": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string"
    },
    "affected": {
      "type": "string"
    },
    "fixed_by": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+\\.[0-9]+$": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "mitigation": {
      "type": "object",
      "properties": {
        "setting": {
          "type": "string"
        },
        "recommended_value": {
          "type": "string"
        },
        "until": {
          "type": "string"
        }
      },
      "required": [
        "setting",
        "recommended_value"
      ],
      "additionalProperties": false
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "mitigation"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "fixed_by": {
            "maxProperties": 0
          },
          "mitigation": {
            "type": "object"
          }
        },
        "required": [
          "mitigation"
        ]
      },
      "else": {
        "properties": {
          "fixed_by": {
            "minProperties": 1
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
