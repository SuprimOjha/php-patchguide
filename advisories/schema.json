{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SuprimOjha/php-patchguide/blob/main/advisories/schema.json",
  "title": "PHP PatchGuide advisory",
  "type": "object",
  "required": [
    "id",
    "title",
    "severity",
    "fixed_by",
    "url"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "published": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string"
    },
    "affected": {
      "type": "string"
    },
    "fixed_by": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[0-9]+\\.[0-9]+$": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
